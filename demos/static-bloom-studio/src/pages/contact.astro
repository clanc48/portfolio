---
import SiteLayout from "../layouts/SiteLayout.astro";
---
<SiteLayout title="Contact | Static Bloom Studio"><section class="pageHero container"><p style="font-family:var(--mono);font-weight:700">STATIC BLOOM / NEW BUSINESS</p><h1>Contact</h1><p>Bring the problem, the ambition, the constraints, and the thing everyone keeps avoiding.</p></section><section class="container"><form class="contactForm" id="contact-form"><label>Name<input required autocomplete="name"></label><label>Email<input required type="email" autocomplete="email"></label><label>Project type<select><option>Brand identity</option><option>Website / digital</option><option>Campaign</option><option>Motion system</option><option>Mixed engagement</option></select></label><label>Timing<select><option>Exploring</option><option>1–3 months</option><option>3–6 months</option></select></label><label class="full">What needs to change?<textarea required rows="6"></textarea></label><button type="submit">Complete project brief</button><p id="contact-status" class="status" role="status" hidden>Demo brief complete. Nothing was transmitted.</p></form></section><script>document.getElementById('contact-form')?.addEventListener('submit',e=>{e.preventDefault();document.getElementById('contact-status').hidden=false;});</script></SiteLayout>