---
import SiteLayout from "../layouts/SiteLayout.astro";
const work=[["Nocturne","Brand","Culture platform identity and launch system."],["Voidline","Digital","Product launch site with motion-led storytelling."],["Relay FM","Campaign","Editorial campaign system across digital placements."],["Morrow Objects","Brand","Naming, identity, packaging, and commerce art direction."]];
---
<SiteLayout title="Work | Static Bloom Studio"><section class="pageHero container"><p style="font-family:var(--mono);font-weight:700">STATIC BLOOM / SELECTED WORK</p><h1>Work</h1><p>Filter the fictional projects by discipline. The interaction demonstrates a lightweight portfolio browser without introducing a framework dependency.</p></section><section class="container"><div class="filterBar" role="group" aria-label="Filter work"><button class="active" data-filter="All">All</button><button data-filter="Brand">Brand</button><button data-filter="Digital">Digital</button><button data-filter="Campaign">Campaign</button></div><div class="caseGrid">{work.map(([name,type,desc])=><article class="caseCard" data-type={type}><p style="font-family:var(--mono)">{type}</p><h2>{name}</h2><p>{desc}</p></article>)}</div></section><script>const btns=document.querySelectorAll('[data-filter]');const cards=document.querySelectorAll('[data-type]');btns.forEach(btn=>btn.addEventListener('click',()=>{const f=btn.getAttribute('data-filter');btns.forEach(x=>x.classList.remove('active'));btn.classList.add('active');cards.forEach(card=>{card.style.display=f==='All'||card.getAttribute('data-type')===f?'':'none';});}));</script></SiteLayout>