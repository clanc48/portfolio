---
import "../styles/site.css";
const { title = "Static Bloom Studio" } = Astro.props;
const nav=[["Work","/work"],["Services","/services"],["Studio","/studio"],["Contact","/contact"]];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{title}</title></head><body>
<header class="header container"><a class="brand" href="/"><span class="flower">✣</span><span>STATIC BLOOM<small>STUDIO</small></span></a><nav>{nav.map(([label,href]) => <a href={href}>{label}</a>)}</nav></header>
<slot />
<footer><div class="container footer-grid"><div><strong>STATIC BLOOM STUDIO</strong><p>Ideas in motion.</p></div><div>Brands · Experiences · Culture</div></div></footer></body></html>