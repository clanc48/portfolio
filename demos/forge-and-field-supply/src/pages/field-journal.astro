---
import SiteLayout from "../layouts/SiteLayout.astro";
const posts=[["PACKING","What we stopped carrying after 300 trail miles","Weight savings matter less than removing gear you never reach for."],["CARE","Drying a shell without killing the finish","A maintenance guide organized around dirt, heat, and water-repellency recovery."],["CAMP","The two-tools rule","How a small repair kit handles more problems when each item earns multiple jobs."],["TRAIL","Cold rain is a systems problem","Layering, pace, food, and shelter choices that matter together."]];
---
<SiteLayout title="Field Journal | Forge & Field Supply"><section class="page-hero container"><p class="eyebrow">Use creates knowledge</p><h1>Field Journal</h1><p>Editorial content gives the commerce demo a useful non-transactional reason to return.</p></section><section class="journalGrid container">{posts.map(([tag,title,desc])=><article class="journalCard"><p class="eyebrow">{tag}</p><h2>{title}</h2><p>{desc}</p><a href="#">Read field note →</a></article>)}</section></SiteLayout>