---
import SiteLayout from "../layouts/SiteLayout.astro";
const collections=[["72-Hour Camp","Camp","A compact shelter, sleep, cooking, lighting, and repair system for a long weekend."],["Wet Trail","Trail","Shell, pack protection, grip, layering, and maintenance choices for persistent rain."],["Truck Kit","Tools","A practical repair and recovery baseline that stays in the vehicle."],["Cold Morning","Layers","Breathable insulation and shell combinations for stop-start activity."]];
---
<SiteLayout title="Collections | Forge & Field Supply"><section class="page-hero page-hero--collections container"><p class="eyebrow">Built around use</p><h1>Collections</h1><p>Collections solve a field problem instead of grouping products by marketing season.</p></section><section class="collectionGrid container">{collections.map(([name,type,desc])=><article class="collectionCard"><p class="eyebrow">{type}</p><h2>{name}</h2><p>{desc}</p><h3>Selection logic</h3><ul><li>Low redundancy</li><li>Repairable failure points</li><li>Weight justified by usefulness</li></ul></article>)}</section></SiteLayout>