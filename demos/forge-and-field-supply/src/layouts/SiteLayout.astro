---
import "../styles/site.css";
const { title = "Forge & Field Supply" } = Astro.props;
const nav=[["Shop","/shop"],["Collections","/collections"],["Field Journal","/field-journal"],["Support","/support"]];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{title}</title></head><body>
<header class="header container"><a class="brand" href="/"><span class="peak">▲</span><span>FORGE & FIELD<small>SUPPLY</small></span></a><nav>{nav.map(([label,href]) => <a href={href}>{label}</a>)}</nav><a class="button" href="/shop">Shop gear</a></header>
<slot />
<footer><div class="container footer-grid"><div><strong>Forge & Field Supply</strong><p>Trusted gear for wherever you go.</p></div><div>Explore · Equip · Belong</div></div></footer></body></html>