{
  "name": "portfolio/hale-mercer-legal",
  "type": "project",
  "description": "Five-page Laravel portfolio demo for Hale Mercer Legal.",
  "require": {
    "php": "8.3.*",
    "laravel/framework": "12.0.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
